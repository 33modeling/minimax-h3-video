# shortform-studio 설정 예시. 복사해서 쓰세요: cp .env.example .env   (scripts/setup.sh 는 .env 가 없을 때 자동 복사)
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 키 값은 여기(.env)에만 넣으세요.
# source scripts/env.sh 가 읽습니다. 빈 값은 건너뛰고, 셸에 이미 있는 값은 덮어쓰지 않습니다. 주석은 줄 맨 앞에만.

# ── AI 서버 (CLI 의 --server / --ref-server 기본값) ──
# fl2va(텍스트·첫 프레임 → 영상, 30010). 비우면 H3_ENDPOINT 를 씀
SHORTS_SERVER=
# ref2va(소스 영상·참조 → 영상, 30011). 비우면 H3_REF_ENDPOINT 를 씀
SHORTS_REF_SERVER=
# minimax-h3-video 규약 이름도 그대로 됩니다 (SSH 터널 예)
# H3_ENDPOINT=http://127.0.0.1:30010
# H3_REF_ENDPOINT=http://127.0.0.1:30011

# 클러스터: minimax-h3-video 체크아웃 경로. 있으면 env.sh 가 그 cluster_env.sh 에서 주소 변수만 읽음
H3_REPO=

# 서버와 공유된 inbox 폴더(SGLang 이 file:// 로 읽음). 클러스터에선 H3_INBOX_DIR 이 기본
SHORTS_INBOX=
SHORTS_INBOX_URI=

# ── 키 (값은 비워 두고 .env 에만 채우기) ──
# 서버에 --api-key 를 걸었을 때 Authorization: Bearer
SHORTS_API_KEY=
# Claude 기획(shorts plan, run --idea)
ANTHROPIC_API_KEY=

# ── 합성 ──
# 한글 글꼴. 비우면 자동(.tools/fonts → fc-match → fc-list :lang=ko)
SHORTS_FONT=
# ffmpeg/ffprobe 직접 지정(보통 비움: .tools/bin → PATH 순)
SHORTS_FFMPEG=
SHORTS_FFPROBE=
# 기본 해상도·fps·품질 (옵션·JSON 에 없을 때만 씀). 비우면 720x1280 · 30 · medium
# 예: SHORTS_RESOLUTION=1080x1920
SHORTS_RESOLUTION=
SHORTS_FPS=
SHORTS_QUALITY=
